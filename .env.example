# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (Set USE_SQLITE=True to use SQLite, or False to use MySQL)
USE_SQLITE=True

# Database (MySQL - used when USE_SQLITE=False)
DB_NAME=cluster_audit
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Media / Static
MEDIA_URL=/media/
STATIC_URL=/static/

# Time
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Redis / Cache & Celery
REDIS_URL=redis://127.0.0.1:6379/0
# STYLEHR_CACHE_TTL: 7 days in seconds (7 * 86400)
STYLEHR_CACHE_TTL=604800
